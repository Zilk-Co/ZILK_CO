# Frontend (Vite) environment — copy to `.env` and fill real values.
# NEVER commit `.env`. These are also set in the Vercel/Render dashboards.

# Sanity CMS
VITE_SANITY_PROJECT_ID=rlnj2yx2
VITE_SANITY_DATASET=production
VITE_SANITY_TOKEN=your_sanity_write_token

# Google Analytics 4
VITE_GA_ID=G-GF9ZMFDFQQ

# Canonical site URL
VITE_SITE_URL=https://zilkco.vercel.app

# API base used by the blog (Neon-backed). Leave unset to fall back to
# static/Sanity content.
VITE_API_URL=/api
